Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Bounding Boxes1
        - /History Trails1
        - /Predicted Footprints1
        - /Predicted Paths1
        - /Predicted Poses1
      Splitter Ratio: 0.5
    Tree Height: 750
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root

  Displays:

    # ── Ground grid ─────────────────────────────────────────────────────────
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Value: Lines
        Line Width: 0.03
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    # ── 3-D bounding box at current position (semi-transparent cube) ────────
    - Class: rviz_default_plugins/MarkerArray
      Name: Bounding Boxes
      Enabled: true
      Topic:
        Value: /tracked_objects/bounding_boxes
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true

    # ── Past-position trail (last N timesteps) ──────────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: History Trails
      Enabled: true
      Topic:
        Value: /tracked_objects/history
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true

    # ── Predicted object footprints (CUBE_LIST sized from bbox + spine) ─────
    #    Mirrors /tracked_objects/predicted_path_array in RViz2-renderable form.
    #    Each cube = exact object volume at that future timestep; alpha fades
    #    from solid (now) to transparent (furthest step).
    - Class: rviz_default_plugins/MarkerArray
      Name: Predicted Footprints
      Enabled: true
      Topic:
        Value: /tracked_objects/predicted_path_array/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true

    # ── Predicted future paths + ID/speed labels ───────────────────────────
    - Class: rviz_default_plugins/MarkerArray
      Name: Predicted Paths
      Enabled: true
      Topic:
        Value: /tracked_objects/predicted_paths
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true

    # ── All predicted waypoints as flat arrows ──────────────────────────────
    - Class: rviz_default_plugins/PoseArray
      Name: Predicted Poses
      Enabled: true
      Color: 0; 200; 255
      Shape: Arrow (Flat)
      Head Length: 0.07
      Head Radius: 0.03
      Shaft Length: 0.23
      Shaft Radius: 0.01
      Axes Length: 0.3
      Axes Radius: 0.01
      Topic:
        Value: /tracked_objects/predicted_pose_array
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
      Value: true

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select

  Transformation:
    Current:
      Class: rviz_default_plugins/TF

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-Down View
      Scale: 20
      X: 0
      Y: 0
      Invert Z Axis: false
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~

Window Geometry:
  Width: 1280
  Height: 800
  X: 0
  Y: 30
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: true
